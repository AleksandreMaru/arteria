# Copy values into Cloudflare Pages → Settings → Environment variables
# (Production + Preview). Do not commit real secrets.

RESEND_API_KEY=re_xxxxxxxx
# Comma-separated for multiple inboxes:
REGISTER_TO_EMAIL=you@example.com,partner@example.com
