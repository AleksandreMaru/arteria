---
import PageLayout from "../../components/layout/PageLayout.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { getUi } from "../../lib/i18n";
import { isLocale, localeStaticPaths } from "../../lib/routes";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) {
  return Astro.redirect("/ka/about");
}
const locale = localeParam;
const ui = getUi(locale);
const currentPath = Astro.url.pathname;

const body =
  locale === "ka"
    ? [
        "გამარჯობა,",
        "ჩვენ ვართ არტარეაედელები და გთავაზობთ სივრცეს სადაც ცოდნა შთაგონებად იქცევა, კულტურა აღმოჩენად და სწავლა გამოცდილებად.",
        "ჩვენ არ ვყოფთ ადამიანებს წლოვანების მიხედვით. შემეცნებას არ აქვს ასაკი.",
        "ჩვენ ვქმნით საგანმანათლებლო კურსებს მათთვის, ვისაც აინტერესებს უფრო მეტი, ვიდრე უბრალოდ ფაქტების ცოდნაა.",
        "ჩვენ გვჯერა, რომ სწავლა შეიძლება იყოს ცნობისმოყვარე, ცოცხალი, ემოციური და შემოქმედებითი.",
        "ჩვენთან კულტურა საუბრობს, რათა აღმოაჩინო ის, რაც ჯერ არ გინახავს და არ გსმენია.",
        "არტარეა-ედი აერთიანებს ადამიანებს, იდეებს, ხელოვნებას, ფსიქოლოგიას, კულტურას და ქმნის სივრცეს ახალი ხედვებისთვის, აღმოჩენებისა და განვითარებისთვის.",
        "რადგან არტარეა-ედი ცოდნის მიღმა აღმოჩენაა, შემოგვიერთდი და აღმოაჩინე მეტი.",
        "საუკეთესო სურვილებით,",
      ]
    : [
        "Hello,",
        "We are the ARTAREA ED community, and we offer a space where knowledge becomes inspiration, culture becomes discovery, and learning becomes experience.",
        "We do not divide people by age. Curiosity has no age.",
        "We create educational courses for those who want more than simply knowing facts.",
        "We believe learning can be curious, alive, emotional, and creative.",
        "With us, culture speaks — so you can discover what you have not yet seen or heard.",
        "ARTAREA ED brings people, ideas, art, psychology, and culture together, and creates a space for new perspectives, discoveries, and growth.",
        "Because ARTAREA ED is discovery beyond knowledge — join us and discover more.",
        "Best wishes,",
      ];
---

<PageLayout
  locale={locale}
  title={ui.about.title}
  description={ui.about.subtitle}
  currentPath={currentPath}
>
  <SectionHeader title={ui.about.title} subtitle={ui.about.subtitle} />
  <div class="prose-content max-w-3xl text-base text-muted">
    {body.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</PageLayout>
