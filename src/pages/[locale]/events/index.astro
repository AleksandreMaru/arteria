---
import PageLayout from "../../../components/layout/PageLayout.astro";
import SectionHeader from "../../../components/ui/SectionHeader.astro";
import EventCard from "../../../components/cards/EventCard.astro";
import { getEvents } from "../../../lib/content";
import { getUi } from "../../../lib/i18n";
import { isLocale, localeStaticPaths } from "../../../lib/routes";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) {
  return Astro.redirect("/ka/events");
}
const locale = localeParam;
const ui = getUi(locale);
const events = getEvents();
const currentPath = Astro.url.pathname;
---

<PageLayout
  locale={locale}
  title={ui.events.title}
  description={ui.events.subtitle}
  currentPath={currentPath}
>
  <SectionHeader title={ui.events.title} subtitle={ui.events.subtitle} />
  <div>
    {events.map((event) => <EventCard locale={locale} event={event} />)}
  </div>
</PageLayout>
