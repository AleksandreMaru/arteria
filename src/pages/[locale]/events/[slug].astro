---
import PageLayout from "../../../components/layout/PageLayout.astro";
import CategoryTag from "../../../components/ui/CategoryTag.astro";
import FormCTA from "../../../components/ui/FormCTA.astro";
import { getEvent, getEvents } from "../../../lib/content";
import { formatDate, getLocalized, getUi } from "../../../lib/i18n";
import { isLocale } from "../../../lib/routes";
import { LOCALES } from "../../../lib/types";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    getEvents().map((event) => ({
      params: { locale, slug: event.slug },
    })),
  );
}

const { locale: localeParam, slug } = Astro.params;
if (!localeParam || !isLocale(localeParam) || !slug) {
  return Astro.redirect("/ka/events");
}
const locale = localeParam;
const event = getEvent(slug);
if (!event) {
  return Astro.redirect(`/${locale}/events`);
}
const ui = getUi(locale);
const currentPath = Astro.url.pathname;
---

<PageLayout
  locale={locale}
  title={getLocalized(event.title, locale)}
  description={getLocalized(event.summary, locale)}
  currentPath={currentPath}
  ogImage={event.heroImage}
>
  <article>
    {
      event.heroImage && (
        <div class="mb-8 aspect-[21/9] overflow-hidden bg-bg-subtle">
          <img src={event.heroImage} alt="" class="h-full w-full object-cover" />
        </div>
      )
    }
    <CategoryTag locale={locale} label={ui.categories.event} />
    <h1 class="mt-4 font-headline text-3xl font-semibold md:text-5xl">
      {getLocalized(event.title, locale)}
    </h1>
    <p class="mt-4 text-sm text-muted">
      {formatDate(event.date, locale)} · {getLocalized(event.venue, locale)}
    </p>
    <div class="prose-content mt-8 max-w-3xl text-base text-muted">
      {
        getLocalized(event.body, locale)
          .split("\n\n")
          .map((paragraph) => <p>{paragraph}</p>)
      }
    </div>
    {
      event.formUrl && (
        <FormCTA locale={locale} formUrl={event.formUrl} label={ui.courses.register} />
      )
    }
  </article>
</PageLayout>
