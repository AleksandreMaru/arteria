---
import PageLayout from "../../../components/layout/PageLayout.astro";
import CategoryTag from "../../../components/ui/CategoryTag.astro";
import { getSpotlight, getSpotlights } from "../../../lib/content";
import { formatDate, getLocalized, getUi } from "../../../lib/i18n";
import { isLocale } from "../../../lib/routes";
import { LOCALES } from "../../../lib/types";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    getSpotlights().map((item) => ({
      params: { locale, slug: item.slug },
    })),
  );
}

const { locale: localeParam, slug } = Astro.params;
if (!localeParam || !isLocale(localeParam) || !slug) {
  return Astro.redirect("/ka/spotlight");
}
const locale = localeParam;
const item = getSpotlight(slug);
if (!item) {
  return Astro.redirect(`/${locale}/spotlight`);
}
const ui = getUi(locale);
const currentPath = Astro.url.pathname;
---

<PageLayout
  locale={locale}
  title={getLocalized(item.title, locale)}
  description={getLocalized(item.summary, locale)}
  currentPath={currentPath}
  ogImage={item.heroImage}
>
  <article class="max-w-3xl">
    {
      item.heroImage && (
        <div class="mb-8 aspect-[16/10] overflow-hidden bg-bg-subtle">
          <img src={item.heroImage} alt="" class="h-full w-full object-cover" />
        </div>
      )
    }
    <CategoryTag locale={locale} label={ui.categories.spotlight} />
    <h1 class="mt-4 font-headline text-3xl font-semibold md:text-5xl">
      {getLocalized(item.title, locale)}
    </h1>
    <p class="mt-4 text-sm text-muted">
      {ui.editorial.by} {item.author} · {formatDate(item.date, locale)}
    </p>
    <div class="prose-content mt-8 text-base text-muted">
      {
        getLocalized(item.body, locale)
          .split("\n\n")
          .map((paragraph) => <p>{paragraph}</p>)
      }
    </div>
  </article>
</PageLayout>
