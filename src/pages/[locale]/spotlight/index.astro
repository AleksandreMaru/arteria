---
import PageLayout from "../../../components/layout/PageLayout.astro";
import SectionHeader from "../../../components/ui/SectionHeader.astro";
import ArticleCard from "../../../components/cards/ArticleCard.astro";
import { getSpotlights } from "../../../lib/content";
import { getUi, localePath } from "../../../lib/i18n";
import { isLocale, localeStaticPaths } from "../../../lib/routes";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) {
  return Astro.redirect("/ka/spotlight");
}
const locale = localeParam;
const ui = getUi(locale);
const spotlights = getSpotlights();
const currentPath = Astro.url.pathname;
---

<PageLayout
  locale={locale}
  title={ui.editorial.spotlightTitle}
  description={ui.editorial.spotlightSubtitle}
  currentPath={currentPath}
>
  <SectionHeader
    title={ui.editorial.spotlightTitle}
    subtitle={ui.editorial.spotlightSubtitle}
  />
  <div class="divide-y divide-border">
    {
      spotlights.map((item) => (
        <ArticleCard
          locale={locale}
          href={localePath(locale, `/spotlight/${item.slug}`)}
          category={ui.categories.spotlight}
          title={item.title}
          meta={`${ui.editorial.by} ${item.author}`}
          date={item.date}
          image={item.heroImage}
        />
      ))
    }
  </div>
</PageLayout>
