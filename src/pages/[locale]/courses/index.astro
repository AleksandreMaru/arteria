---
import PageLayout from "../../../components/layout/PageLayout.astro";
import SectionHeader from "../../../components/ui/SectionHeader.astro";
import CourseCard from "../../../components/cards/CourseCard.astro";
import { getCourses } from "../../../lib/content";
import { getUi } from "../../../lib/i18n";
import { isLocale, localeStaticPaths } from "../../../lib/routes";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) {
  return Astro.redirect("/ka/courses");
}
const locale = localeParam;
const ui = getUi(locale);
const courses = getCourses();
const currentPath = Astro.url.pathname;
---

<PageLayout
  locale={locale}
  title={ui.courses.title}
  description={ui.courses.subtitle}
  currentPath={currentPath}
>
  <SectionHeader title={ui.courses.title} subtitle={ui.courses.subtitle} />
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {courses.map((course) => <CourseCard locale={locale} course={course} />)}
  </div>
</PageLayout>
