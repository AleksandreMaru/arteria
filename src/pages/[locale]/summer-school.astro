---
import PageLayout from "../../components/layout/PageLayout.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import CategoryTag from "../../components/ui/CategoryTag.astro";
import FormCTA from "../../components/ui/FormCTA.astro";
import { getSummerSchool } from "../../lib/content";
import { getLocalized, getUi } from "../../lib/i18n";
import { isLocale, localeStaticPaths } from "../../lib/routes";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) {
  return Astro.redirect("/ka/summer-school");
}
const locale = localeParam;
const ui = getUi(locale);
const school = getSummerSchool();
const currentPath = Astro.url.pathname;
---

<PageLayout
  locale={locale}
  title={ui.summerSchool.title}
  description={getLocalized(school.intro, locale)}
  currentPath={currentPath}
  ogImage={school.heroImage}
>
  <SectionHeader
    title={ui.summerSchool.title}
    subtitle={ui.summerSchool.subtitle}
  />

  {
    school.heroImage && (
      <div class="mb-10 aspect-[21/9] overflow-hidden bg-bg-subtle">
        <img src={school.heroImage} alt="" class="h-full w-full object-cover" />
      </div>
    )
  }

  <CategoryTag locale={locale} label={ui.categories.summerSchool} />
  <p class="mt-4 max-w-3xl text-lg leading-relaxed">
    {getLocalized(school.intro, locale)}
  </p>

  <dl class="mt-10 grid gap-6 border-y border-border py-8 md:grid-cols-3">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">
        {ui.summerSchool.ages}
      </dt>
      <dd class="mt-2 font-headline text-xl">{getLocalized(school.ages, locale)}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">
        {ui.summerSchool.location}
      </dt>
      <dd class="mt-2 font-headline text-xl">
        {getLocalized(school.location, locale)}
      </dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">
        {ui.summerSchool.dates}
      </dt>
      <dd class="mt-2 font-headline text-xl">{getLocalized(school.dates, locale)}</dd>
    </div>
  </dl>

  <section class="mt-12">
    <h2 class="font-headline text-2xl font-semibold">{ui.summerSchool.curriculum}</h2>
    <div class="mt-6 divide-y divide-border">
      {
        school.curriculum.map((block) => (
          <div class="py-6">
            <h3 class="font-headline text-lg font-semibold">
              {getLocalized(block.title, locale)}
            </h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
              {getLocalized(block.description, locale)}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-12">
    <h2 class="font-headline text-2xl font-semibold">{ui.summerSchool.dailyRhythm}</h2>
    <div class="mt-6 max-w-xl divide-y divide-border">
      {
        school.dailyRhythm.map((item) => (
          <div class="flex gap-6 py-4">
            <span class="w-16 shrink-0 text-sm font-medium">{item.time}</span>
            <span class="text-sm text-muted">
              {getLocalized(item.activity, locale)}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-12">
    <h2 class="font-headline text-2xl font-semibold">{ui.summerSchool.faq}</h2>
    <div class="mt-6 divide-y divide-border">
      {
        school.faq.map((item) => (
          <details class="group py-5">
            <summary class="cursor-pointer font-medium group-open:text-accent">
              {getLocalized(item.question, locale)}
            </summary>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
              {getLocalized(item.answer, locale)}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <FormCTA
    locale={locale}
    formUrl={school.formUrl}
    label={ui.summerSchool.apply}
  />
</PageLayout>
