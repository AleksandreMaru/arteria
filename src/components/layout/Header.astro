---
import type { Locale } from "../../lib/types";
import { getUi, localePath } from "../../lib/i18n";
import LangSwitcher from "../ui/LangSwitcher.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const ui = getUi(locale);
const base = localePath(locale);

const links = [
  { href: `${base}courses`, label: ui.nav.courses },
  { href: `${base}summer-school`, label: ui.nav.summerSchool },
  { href: `${base}tours`, label: ui.nav.tours },
  { href: `${base}about`, label: ui.nav.about },
  { href: `${base}contact`, label: ui.nav.contact },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-white/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-5 md:px-8 md:py-6">
    <a href={base} class="shrink-0" aria-label="ARTAREA ED">
      <img src="/logo.svg" alt="ARTAREA ED" class="h-10 w-auto md:h-12" />
    </a>

    <nav class="hidden items-center gap-10 lg:flex" aria-label="Main">
      {
        links.slice(0, 4).map((link) => (
          <a
            href={link.href}
            class="font-headline text-lg font-semibold tracking-tight transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4 md:gap-6">
      <LangSwitcher locale={locale} currentPath={currentPath} />
      <button
        type="button"
        data-open-register
        class="hidden min-h-12 items-center justify-center bg-accent px-7 py-3.5 text-base font-medium text-white transition-colors hover:bg-black sm:inline-flex"
      >
        {ui.courses.register}
      </button>
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex h-12 w-12 items-center justify-center border border-border lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span class="sr-only">Menu</span>
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M0 1H18M0 6H18M0 11H18" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-border bg-white lg:hidden"
    aria-label="Mobile"
  >
    <div class="mx-auto flex max-w-7xl flex-col px-5 py-5 md:px-8">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="border-b border-border py-3.5 font-headline text-lg font-semibold last:border-b-0"
          >
            {link.label}
          </a>
        ))
      }
      <button
        type="button"
        data-open-register
        class="mt-5 inline-flex min-h-12 items-center justify-center bg-accent px-7 py-3.5 text-base font-medium text-white"
      >
        {ui.courses.register}
      </button>
    </div>
  </nav>
</header>

<script>
  import { openRegisterModal } from "../../lib/register";

  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", isOpen);
    btn.setAttribute("aria-expanded", String(!isOpen));
  });

  function bindRegisterButtons() {
    document.querySelectorAll<HTMLElement>("[data-open-register]").forEach((el) => {
      if (el.dataset.bound === "1") return;
      el.dataset.bound = "1";
      el.addEventListener("click", () => {
        openRegisterModal(el.dataset.openRegister || undefined);
      });
    });
  }

  bindRegisterButtons();
</script>
