---
import type { Locale } from "../../lib/types";
import { getUi, localePath } from "../../lib/i18n";
import LangSwitcher from "../ui/LangSwitcher.astro";
import Button from "../ui/Button.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const ui = getUi(locale);
const base = localePath(locale);

const links = [
  { href: `${base}courses`, label: ui.nav.courses },
  { href: `${base}summer-school`, label: ui.nav.summerSchool },
  { href: `${base}tours`, label: ui.nav.tours },
  { href: `${base}about`, label: ui.nav.about },
];

const storyLinks = [
  { href: `${base}interviews`, label: ui.nav.interviews },
  { href: `${base}spotlight`, label: ui.nav.spotlight },
  { href: `${base}events`, label: ui.nav.events },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-white/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 md:px-8">
    <a href={base} class="shrink-0" aria-label="ARTAREA ED">
      <img src="/logo.svg" alt="ARTAREA ED" class="h-8 w-auto md:h-9" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main">
      {
        links.slice(0, 3).map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
      <div class="group relative">
        <button
          type="button"
          class="text-sm font-medium transition-colors hover:text-accent"
          aria-haspopup="true"
        >
          {ui.nav.stories}
        </button>
        <div
          class="invisible absolute left-0 top-full z-50 min-w-[180px] border border-border bg-white py-2 opacity-0 shadow-sm transition-all group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          {
            storyLinks.map((link) => (
              <a
                href={link.href}
                class="block px-4 py-2 text-sm transition-colors hover:bg-bg-subtle hover:text-accent"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
      <a
        href={`${base}about`}
        class="text-sm font-medium transition-colors hover:text-accent"
      >
        {ui.nav.about}
      </a>
    </nav>

    <div class="flex items-center gap-4 md:gap-6">
      <LangSwitcher locale={locale} currentPath={currentPath} />
      <Button href={`${base}courses`} class="hidden sm:inline-flex">
        {ui.nav.learnMore}
      </Button>
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex h-10 w-10 items-center justify-center border border-border lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span class="sr-only">Menu</span>
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M0 1H18M0 6H18M0 11H18" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-border bg-white lg:hidden"
    aria-label="Mobile"
  >
    <div class="mx-auto flex max-w-7xl flex-col px-5 py-4 md:px-8">
      {
        [...links, ...storyLinks, { href: `${base}contact`, label: ui.nav.contact }].map(
          (link) => (
            <a
              href={link.href}
              class="border-b border-border py-3 text-sm font-medium last:border-b-0"
            >
              {link.label}
            </a>
          ),
        )
      }
      <a
        href={`${base}courses`}
        class="mt-4 inline-flex items-center justify-center bg-accent px-5 py-3 text-sm font-medium text-white"
      >
        {ui.nav.learnMore}
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", isOpen);
    btn.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
