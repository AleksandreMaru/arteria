---
import type { Course } from "../../lib/schemas";
import type { Locale } from "../../lib/types";
import { getLocalized, getUi, localePath } from "../../lib/i18n";
import CategoryTag from "../ui/CategoryTag.astro";

interface Props {
  locale: Locale;
  course: Course;
}

const { locale, course } = Astro.props;
const ui = getUi(locale);
const href = localePath(locale, `/courses/${course.slug}`);
const price = ui.courses.pricePerMonth.replace(
  "{amount}",
  String(course.priceMonthly),
);
---

<article class="group border border-border bg-white p-5 transition-shadow hover:shadow-sm">
  <a href={href}>
    {
      course.heroImage && (
        <div class="mb-4 aspect-[16/10] overflow-hidden bg-bg-subtle">
          <img
            src={course.heroImage}
            alt=""
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      )
    }
    <CategoryTag locale={locale} label={ui.disciplines[course.discipline]} />
    <h3 class="mt-3 font-headline text-lg font-semibold leading-snug group-hover:text-accent">
      {getLocalized(course.title, locale)}
    </h3>
    <p class="mt-2 text-sm text-muted">
      {ui.courses.instructor}: {course.instructor}
    </p>
    <p class="mt-1 text-sm text-muted">
      {getLocalized(course.durationText, locale)} ·{" "}
      {getLocalized(course.scheduleText, locale)}
    </p>
    <p class="mt-1 text-sm font-medium text-black">{price}</p>
    <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted">
      {getLocalized(course.summary, locale)}
    </p>
  </a>
</article>
