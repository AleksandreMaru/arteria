---
import type { Locale } from "../../lib/types";
import type { LocalizedString } from "../../lib/types";
import { formatDate, getLocalized, getUi, localePath } from "../../lib/i18n";
import CategoryTag from "../ui/CategoryTag.astro";

interface Props {
  locale: Locale;
  href: string;
  category: string;
  title: LocalizedString;
  meta?: string;
  date?: string;
  image?: string;
}

const { locale, href, category, title, meta, date, image } = Astro.props;
const ui = getUi(locale);
---

<article class="group border-t border-border py-6 first:border-t-0 md:py-8">
  <a href={href} class="grid gap-4 md:grid-cols-[1fr_180px] md:items-start">
    <div>
      <CategoryTag locale={locale} label={category} />
      <h3 class="mt-3 font-headline text-xl font-semibold leading-snug transition-colors group-hover:text-accent md:text-2xl">
        {getLocalized(title, locale)}
      </h3>
      {
        (meta || date) && (
          <p class="mt-3 text-sm text-muted">
            {meta}
            {meta && date && " · "}
            {date && formatDate(date, locale)}
          </p>
        )
      }
    </div>
    {
      image && (
        <div class="aspect-[4/3] overflow-hidden bg-bg-subtle">
          <img
            src={image}
            alt=""
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      )
    }
  </a>
</article>
