---
import type { Tour } from "../../lib/schemas";
import type { Locale } from "../../lib/types";
import { formatDate, getLocalized, getUi, localePath } from "../../lib/i18n";
import CategoryTag from "../ui/CategoryTag.astro";

interface Props {
  locale: Locale;
  tour: Tour;
}

const { locale, tour } = Astro.props;
const ui = getUi(locale);
const href = localePath(locale, `/tours/${tour.slug}`);
const nextDate = [...tour.dates].sort()[0];
---

<article class="group border border-border bg-white p-5 transition-shadow hover:shadow-sm">
  <a href={href}>
    {
      tour.heroImage && (
        <div class="mb-4 aspect-[16/10] overflow-hidden bg-bg-subtle">
          <img
            src={tour.heroImage}
            alt=""
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      )
    }
    <CategoryTag locale={locale} label={ui.categories.tour} />
    <h3 class="mt-3 font-headline text-lg font-semibold leading-snug group-hover:text-accent">
      {getLocalized(tour.title, locale)}
    </h3>
    <p class="mt-2 text-sm text-muted">
      {ui.regions[tour.region]} · {getLocalized(tour.duration, locale)}
      {nextDate && ` · ${formatDate(nextDate, locale)}`}
    </p>
    <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted">
      {getLocalized(tour.summary, locale)}
    </p>
  </a>
</article>
