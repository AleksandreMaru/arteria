---
import type { Locale } from "../../lib/types";
import { getUi } from "../../lib/i18n";

interface Props {
  locale: Locale;
  formUrl: string;
  label?: string;
}

const { locale, formUrl, label } = Astro.props;
const ui = getUi(locale);
const text = label ?? ui.courses.register;
---

<div class="mt-12 border-t border-border pt-10">
  <a
    href={formUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center bg-accent px-8 py-3 text-sm font-medium text-white transition-colors hover:bg-black"
  >
    {text}
  </a>
</div>
