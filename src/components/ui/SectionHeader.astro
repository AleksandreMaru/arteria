---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-10 border-b border-border pb-8 md:mb-14 md:pb-10">
  <h1 class="font-headline text-3xl font-semibold tracking-tight md:text-5xl">
    {title}
  </h1>
  {
    subtitle && (
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
        {subtitle}
      </p>
    )
  }
</div>
