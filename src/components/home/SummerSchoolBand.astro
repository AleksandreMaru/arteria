---
import type { Locale } from "../../lib/types";
import { getLocalized, getUi, localePath } from "../../lib/i18n";
import { getSummerSchool } from "../../lib/content";
import Button from "../ui/Button.astro";
import CategoryTag from "../ui/CategoryTag.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const school = getSummerSchool();
const href = localePath(locale, "/summer-school");
const image =
  school.heroImage ??
  "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=1400&q=80";
---

<section class="border-b border-border py-12 md:py-16">
  <div class="grid gap-8 overflow-hidden border border-border md:grid-cols-2 md:items-stretch">
    <div class="aspect-[4/3] bg-bg-subtle md:aspect-auto">
      <img src={image} alt="" class="h-full w-full object-cover" />
    </div>
    <div class="flex flex-col justify-center px-6 py-8 md:px-10 md:py-12">
      <CategoryTag locale={locale} label={ui.home.summerBandEyebrow} />
      <h2 class="mt-4 font-headline text-3xl font-semibold leading-tight md:text-4xl">
        {getLocalized(school.intro, locale)}
      </h2>
      <p class="mt-4 text-sm text-muted md:text-base">
        {getLocalized(school.ages, locale)} · {getLocalized(school.location, locale)} ·{" "}
        {getLocalized(school.dates, locale)}
      </p>
      <div class="mt-8">
        <Button href={href} size="lg">{ui.home.summerBandCta}</Button>
      </div>
    </div>
  </div>
</section>
