---
import type { Locale } from "../../lib/types";
import { getUi, localePath } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);

const programs = [
  {
    href: localePath(locale, "/summer-school"),
    title: ui.nav.summerSchool,
    description:
      locale === "ka"
        ? "ბავშვებისთვის შემოქმედებითი ზაფხული თბილისის შემოგონებით."
        : "A creative summer for children just outside Tbilisi.",
  },
  {
    href: localePath(locale, "/courses"),
    title: ui.nav.courses,
    description:
      locale === "ka"
        ? "დონე, დრო და ფორმატი — იპოვე შენთვის შესაფერისი კურსი."
        : "Level, schedule, and format — find the course that fits.",
  },
  {
    href: localePath(locale, "/tours"),
    title: ui.nav.tours,
    description:
      locale === "ka"
        ? "სასეირნეო ტურები თბილისიდან მთელ საქართველოში."
        : "Walking tours from Tbilisi across Georgia.",
  },
];
---

<section class="border-b border-border py-12 md:py-16">
  <h2 class="mb-8 font-headline text-2xl font-semibold md:text-3xl">
    {ui.home.programs}
  </h2>
  <div class="grid gap-6 md:grid-cols-3">
    {
      programs.map((program) => (
        <a
          href={program.href}
          class="group border-t-2 border-black pt-5 transition-colors hover:border-accent"
        >
          <h3 class="font-headline text-xl font-semibold group-hover:text-accent">
            {program.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{program.description}</p>
        </a>
      ))
    }
  </div>
</section>
