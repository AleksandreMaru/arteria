---
import type { Locale } from "../../lib/types";
import { getUi } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
---

<section class="border-b border-border py-12 md:py-16">
  <h2 class="mb-8 font-headline text-2xl font-semibold md:text-3xl">
    {ui.home.trustTitle}
  </h2>
  <div class="grid gap-8 md:grid-cols-3">
    {
      ui.home.trust.map((item) => (
        <div class="border-t-2 border-black pt-5">
          <h3 class="font-headline text-xl font-semibold">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.text}</p>
        </div>
      ))
    }
  </div>
</section>
