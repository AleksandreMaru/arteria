---
import type { Locale } from "../../lib/types";
import { getUi, localePath } from "../../lib/i18n";
import { getInterviews, getSpotlights } from "../../lib/content";
import ArticleCard from "../cards/ArticleCard.astro";
import Button from "../ui/Button.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const interviews = getInterviews().slice(0, 2);
const spotlights = getSpotlights().slice(0, 2);
const stories = [...interviews, ...spotlights].slice(0, 4);
---

<section class="border-b border-border py-12 md:py-16">
  <div class="mb-8 flex items-end justify-between gap-4">
    <h2 class="font-headline text-2xl font-semibold md:text-3xl">{ui.home.stories}</h2>
    <Button href={localePath(locale, "/interviews")} variant="secondary" class="hidden sm:inline-flex">
      {ui.home.viewAll}
    </Button>
  </div>
  <div class="divide-y divide-border">
    {
      stories.map((story) => {
        const isInterview = interviews.some((i) => i.slug === story.slug);
        const base = isInterview ? "interviews" : "spotlight";
        return (
          <ArticleCard
            locale={locale}
            href={localePath(locale, `/${base}/${story.slug}`)}
            category={
              isInterview ? ui.categories.interview : ui.categories.spotlight
            }
            title={story.title}
            meta={`${ui.editorial.by} ${story.author}`}
            date={story.date}
            image={story.heroImage}
          />
        );
      })
    }
  </div>
</section>
