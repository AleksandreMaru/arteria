---
import type { Locale } from "../../lib/types";
import { formatDate, getLocalized, getUi, localePath } from "../../lib/i18n";
import { getUpcomingItems } from "../../lib/content";
import CategoryTag from "../ui/CategoryTag.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const items = getUpcomingItems();

function itemHref(type: string, slug: string) {
  const map: Record<string, string> = {
    course: "courses",
    tour: "tours",
    event: "events",
  };
  return localePath(locale, `/${map[type]}/${slug}`);
}

function categoryLabel(type: string) {
  const map: Record<string, string> = {
    course: ui.categories.course,
    tour: ui.categories.tour,
    event: ui.categories.event,
  };
  return map[type] ?? type;
}
---

<section class="border-b border-border py-12 md:py-16">
  <div class="mb-8 flex items-end justify-between gap-4">
    <h2 class="font-headline text-2xl font-semibold md:text-3xl">{ui.home.upcoming}</h2>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    {
      items.map((item) => (
        <a
          href={itemHref(item.type, item.slug)}
          class="group border border-border p-5 transition-shadow hover:shadow-sm"
        >
          <CategoryTag locale={locale} label={categoryLabel(item.type)} />
          <h3 class="mt-3 font-headline text-lg font-semibold leading-snug group-hover:text-accent">
            {getLocalized(item.title, locale)}
          </h3>
          <p class="mt-2 text-sm text-muted">{formatDate(item.date, locale)}</p>
        </a>
      ))
    }
  </div>
</section>
