---
import type { Locale } from "../../lib/types";
import { getLocalized, getUi, localePath } from "../../lib/i18n";
import { getSummerSchool, getSundaySchool } from "../../lib/content";
import Button from "../ui/Button.astro";
import CategoryTag from "../ui/CategoryTag.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const sunday = getSundaySchool();
const summer = getSummerSchool();
const sundayHref = localePath(locale, "/sunday-school");
const summerHref = localePath(locale, "/summer-school");
const sundayImage =
  sunday.heroImage ??
  "https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=1400&q=80";
const summerImage =
  summer.heroImage ??
  "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=1400&q=80";
---

<section class="border-b border-border py-12 md:py-16">
  <h2 class="mb-8 font-headline text-2xl font-semibold md:text-3xl">
    {ui.home.kidsProgramsTitle}
  </h2>
  <div class="grid gap-6 md:grid-cols-2">
    <article class="flex flex-col overflow-hidden border border-border">
      <div class="aspect-[16/10] bg-bg-subtle">
        <img src={sundayImage} alt="" class="h-full w-full object-cover" />
      </div>
      <div class="flex flex-1 flex-col px-6 py-7">
        <CategoryTag locale={locale} label={ui.home.sundayBandEyebrow} />
        <h3 class="mt-4 font-headline text-2xl font-semibold leading-tight">
          {getLocalized(sunday.headline, locale)}
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          {getLocalized(sunday.ages, locale)} ·{" "}
          {getLocalized(sunday.duration, locale)} ·{" "}
          {ui.sundaySchool.pricePerMonth.replace(
            "{amount}",
            String(sunday.priceMonthly),
          )}
        </p>
        <div class="mt-auto pt-7">
          <Button href={sundayHref} size="lg">{ui.home.sundayBandCta}</Button>
        </div>
      </div>
    </article>

    <article class="flex flex-col overflow-hidden border border-border">
      <div class="aspect-[16/10] bg-bg-subtle">
        <img src={summerImage} alt="" class="h-full w-full object-cover" />
      </div>
      <div class="flex flex-1 flex-col px-6 py-7">
        <CategoryTag locale={locale} label={ui.home.summerBandEyebrow} />
        <h3 class="mt-4 font-headline text-2xl font-semibold leading-tight">
          {getLocalized(summer.intro, locale)}
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          {getLocalized(summer.ages, locale)} ·{" "}
          {getLocalized(summer.location, locale)} ·{" "}
          {getLocalized(summer.dates, locale)}
        </p>
        <div class="mt-auto pt-7">
          <Button href={summerHref} size="lg">{ui.home.summerBandCta}</Button>
        </div>
      </div>
    </article>
  </div>
</section>
